GET {{host}}/api/v1/conversations?page=0&size=20&role=SELLER
Authorization: Bearer {{buyerToken}}

> {%
    function inboxItems(body) {
        var json = body;
        if (typeof json === "string") {
            json = JSON.parse(json);
        } else {
            json = JSON.parse(JSON.stringify(json));
