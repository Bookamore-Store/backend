Authorization: Bearer {{sellerToken}}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("seller unreadMessages increased by 1", function() {
        const before = Number(client.global.get("sellerUnreadMessagesBeforeStart"));
        client.assert(response.body.unreadMessages === before + 1,
            "Expected unreadMessages " + (before + 1) + ", got " + response.body.unreadMessages);
    });
%}

