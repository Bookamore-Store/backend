### 17. List messages as buyer
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    const conversationId = client.global.get("conversationId");
    if (!conversationId) {
        throw new Error("conversationId is empty — run '6. Create conversation' first");
    }
    request.variables.set("buyerToken", token);
    request.variables.set("conversationId", conversationId);
%}
GET {{host}}/api/v1/conversations/{{conversationId}}/messages?limit=50
Authorization: Bearer {{buyerToken}}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        const messages = response.body.messages || [];
        const conversationId = client.global.get("conversationId");
        client.global.set("firstMessageId", messages.length ? messages[0].id : null);
        client.global.set("lastMessageId", messages.length ? messages[messages.length - 1].id : null);
        client.test("conversationId matches", function() {
            client.assert(String(response.body.conversationId) === String(conversationId), "Expected same conversationId");
        });
        client.test("at least two messages", function() {
            client.assert(messages.length >= 2, "Expected opening message plus appended start text");
        });
        client.test("messages are chronological", function() {
            for (let i = 1; i < messages.length; i++) {
                client.assert(String(messages[i].id) > String(messages[i - 1].id), "Expected ids in ascending UUIDv7 order");
            }
        });
        client.test("initial message is present", function() {
            const found = messages.some(function(message) {
                return message.content === "Hi, is this book still available?";
            });
            client.assert(found, "Expected initial message text");
        });
        client.test("second start text was appended", function() {
            const found = messages.some(function(message) {
                return message.content === "This second text should be appended as a new buyer message.";
            });
            client.assert(found, "Start on an existing chat must append initialMessage");
        });
    }
%}

