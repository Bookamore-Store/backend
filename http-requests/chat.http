
@host = http://localhost:8080
@offerId = 018d4f1a-5b03-71d4-e001-000000000001
@buyerEmail = jane.smith@example.com
@sellerEmail = john.doe@example.com
@strangerEmail = mike.johnson@example.com
@password = myPassword123
@unknownConversationId = 00000000-0000-7000-8000-000000000099
@unknownMessageId = 00000000-0000-7000-8000-000000000098

### 1. Login buyer
POST {{host}}/api/v1/auth/signin
Content-Type: application/json

{
  "email": "{{buyerEmail}}",
  "password": "{{password}}"
}

> {%
    client.global.set("buyerToken", response.body.token);
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("token is a non-empty string", function() {
        const token = response.body.token;
        client.assert(typeof token === "string" && token.length > 0, "Expected non-empty token");
    });
%}

### 2. Login seller
POST {{host}}/api/v1/auth/signin
Content-Type: application/json

{
  "email": "{{sellerEmail}}",
  "password": "{{password}}"
}

> {%
    client.global.set("sellerToken", response.body.token);
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("token is a non-empty string", function() {
        const token = response.body.token;
        client.assert(typeof token === "string" && token.length > 0, "Expected non-empty token");
    });
%}

### 3. Login stranger
# Mike is neither buyer nor seller of this conversation.
POST {{host}}/api/v1/auth/signin
Content-Type: application/json

{
  "email": "{{strangerEmail}}",
  "password": "{{password}}"
}

> {%
    client.global.set("strangerToken", response.body.token);
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("token is a non-empty string", function() {
        const token = response.body.token;
        client.assert(typeof token === "string" && token.length > 0, "Expected non-empty token");
    });
%}

### 4. Get offer
GET {{host}}/api/v1/offers/{{offerId}}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    client.test("offer id matches offerId", function() {
        const expectedId = request.variables.get("offerId");
        if (expectedId) {
            client.assert(String(response.body.id) === String(expectedId), "Expected id to match {{offerId}}");
        }
    });
    client.test("offer status is OPEN", function() {
        client.assert(response.body.status === "OPEN", "Expected OfferStatus OPEN");
    });
    client.test("seller is John", function() {
        client.assert(response.body.seller != null, "Expected seller");
        client.assert(response.body.seller.name === "John", "Expected seller.name John");
        client.assert(String(response.body.seller.id) === "018d4f1a-5b03-71d4-a716-446655440001", "Expected seller.id of seed John");
    });
%}

### 5. Unread count as seller before start
< {%
    const token = client.global.get("sellerToken");
    if (!token) {
        throw new Error("sellerToken is empty — run '2. Login seller' first");
    }
    request.variables.set("sellerToken", token);
%}
GET {{host}}/api/v1/conversations/unread-count?role=SELLER
Authorization: Bearer {{sellerToken}}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        client.global.set("sellerUnreadMessagesBeforeStart", response.body.unreadMessages);
        client.test("body has unreadMessages", function() {
            client.assert(typeof response.body.unreadMessages === "number", "Expected unreadMessages");
        });
    }
%}

### 6. Create conversation (buyer + initialMessage)
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    request.variables.set("buyerToken", token);
%}
POST {{host}}/api/v1/offers/{{offerId}}/conversations
Authorization: Bearer {{buyerToken}}
Content-Type: application/json

{
  "initialMessage": "Hi, is this book still available?"
}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200,
            "Expected 200, got " + response.status + " " + JSON.stringify(response.body));
    });
    if (response.status === 200) {
        client.global.set("conversationId", response.body.id);
        client.test("conversation has id", function() {
            const id = response.body.id;
            client.assert(id != null && String(id).length > 0, "Expected conversation id");
        });
        client.test("counterpart is the seller", function() {
            client.assert(response.body.counterpart != null, "Expected counterpart");
            client.assert(response.body.counterpart.name === "John", "Expected counterpart.name John");
            client.assert(response.body.counterpart.role === "SELLER", "Expected counterpart.role SELLER");
        });
    }
%}

