### 28. List messages after last known id (polling)
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    const conversationId = client.global.get("conversationId");
    if (!conversationId) {
        throw new Error("conversationId is empty — run '6. Create conversation' first");
    }
    const after = client.global.get("sellerReplyId");
    if (!after) {
        throw new Error("sellerReplyId is empty — run '21. Send message as seller' first");
    }
    request.variables.set("buyerToken", token);
    request.variables.set("conversationId", conversationId);
    request.variables.set("after", after);
%}
GET {{host}}/api/v1/conversations/{{conversationId}}/messages?after={{after}}
Authorization: Bearer {{buyerToken}}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    if (response.status === 200) {
        const messages = response.body.messages || [];
        const after = client.global.get("sellerReplyId");
        client.test("only messages newer than after", function() {
            messages.forEach(function(message) {
                client.assert(String(message.id) > String(after), "Expected id > after");
            });
        });
        client.test("contains buyer reply", function() {
            const found = messages.some(function(message) {
                return message.content === "Great, I will take it.";
            });
            client.assert(found, "Polling after seller reply should include buyer's next message");
        });
        client.test("does not contain the after message itself", function() {
            const found = messages.some(function(message) {
                return String(message.id) === String(after);
            });
            client.assert(!found, "after is exclusive");
        });
    }
%}

### 29. List messages before first id (history)
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    const conversationId = client.global.get("conversationId");
    const before = client.global.get("lastMessageId");
    if (!conversationId || !before) {
        throw new Error("conversationId/lastMessageId missing — run create + list/send first");
    }
    request.variables.set("buyerToken", token);
    request.variables.set("conversationId", conversationId);
    request.variables.set("before", before);
%}
GET {{host}}/api/v1/conversations/{{conversationId}}/messages?before={{before}}&limit=50
Authorization: Bearer {{buyerToken}}

> {%
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    if (response.status === 200) {
        const messages = response.body.messages || [];
        const before = client.global.get("lastMessageId");
        client.test("only messages older than before", function() {
            messages.forEach(function(message) {
                client.assert(String(message.id) < String(before), "Expected id < before");
            });
        });
        client.test("messages are chronological", function() {
            for (let i = 1; i < messages.length; i++) {
                client.assert(String(messages[i].id) > String(messages[i - 1].id), "Expected ascending order");
            }
        });
    }
%}

### 30. List messages after and before together (expect 400)
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    const conversationId = client.global.get("conversationId");
    const cursor = client.global.get("lastMessageId") || client.global.get("firstMessageId");
    if (!conversationId || !cursor) {
        throw new Error("conversationId/cursor missing — run list messages first");
    }
    request.variables.set("buyerToken", token);
    request.variables.set("conversationId", conversationId);
    request.variables.set("cursor", cursor);
%}
GET {{host}}/api/v1/conversations/{{conversationId}}/messages?after={{cursor}}&before={{cursor}}
Authorization: Bearer {{buyerToken}}

> {%
    client.test("status 400", function() {
        client.assert(response.status === 400, "Expected 400 when after and before are both set");
    });
    client.test("message mentions after and before", function() {
        const message = response.body && response.body.message;
        if (message) {
            client.assert(String(message).indexOf("after") !== -1, "Expected error about after/before");
        }
    });
%}

