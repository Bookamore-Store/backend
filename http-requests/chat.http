### 23. Inbox as buyer shows unread and keeps this chat first among unread
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    request.variables.set("buyerToken", token);
%}
GET {{host}}/api/v1/conversations?page=0&size=20&role=BUYER
Authorization: Bearer {{buyerToken}}

> {%
    function inboxItems(body) {
        var json = body;
        if (typeof json === "string") {
            json = JSON.parse(json);
        } else {
            json = JSON.parse(JSON.stringify(json));
        }
        return Array.isArray(json.content) ? json.content : [];
    }
    function findConversation(body, id) {
        const list = inboxItems(body);
        for (let i = 0; i < list.length; i++) {
            if (String(list[i].id) === String(id)) {
                return { item: list[i], index: i };
            }
        }
        return { item: null, index: -1 };
    }
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200");
    });
    if (response.status === 200) {
        const list = inboxItems(response.body);
        const found = findConversation(response.body, client.global.get("conversationId"));
        client.test("conversation unreadCount >= 1", function() {
            client.assert(found.item != null, "Expected conversation in inbox");
            client.assert(found.item.unreadCount >= 1, "Expected unreadCount >= 1 after seller reply");
        });
        client.test("unread chats come before read chats", function() {
            let firstReadIndex = -1;
            for (let i = 0; i < list.length; i++) {
                if (list[i].unreadCount === 0 && firstReadIndex === -1) {
                    firstReadIndex = i;
                }
            }
            if (found.item && found.item.unreadCount > 0 && firstReadIndex !== -1) {
                client.assert(found.index < firstReadIndex, "Unread conversation must appear before read ones");
            }
        });
        client.test("preview is the seller reply", function() {
            if (!found.item) {
                return;
            }
            client.assert(found.item.lastMessagePreview === "Yes, still available.", "Expected lastMessagePreview of seller reply");
        });
    }
%}

