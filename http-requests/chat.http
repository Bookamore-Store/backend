### 13. Inbox as buyer (role=BUYER)
< {%
    const token = client.global.get("buyerToken");
    if (!token) {
        throw new Error("buyerToken is empty — run '1. Login buyer' first");
    }
    request.variables.set("buyerToken", token);
%}
GET {{host}}/api/v1/conversations?page=0&size=20&role=BUYER
Authorization: Bearer {{buyerToken}}

> {%
    function inboxItems(body) {
        var json = body;
        if (typeof json === "string") {
            json = JSON.parse(json);
        } else {
            json = JSON.parse(JSON.stringify(json));
        }
        return Array.isArray(json.content) ? json.content : [];
    }
    function findConversation(body, id) {
        const list = inboxItems(body);
        for (let i = 0; i < list.length; i++) {
            if (String(list[i].id) === String(id)) {
                return list[i];
            }
        }
        return null;
    }
    client.test("status 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    if (response.status === 200) {
        const conversationId = client.global.get("conversationId");
        const item = findConversation(response.body, conversationId);
        client.test("page contains this conversation", function() {
            client.assert(item != null, "Expected conversation " + conversationId + " in buyer BUYER inbox");
        });
        client.test("counterpart is the seller", function() {
            if (!item) {
                return;
            }
            client.assert(item.counterpart != null, "Expected counterpart");
            client.assert(item.counterpart.name === "John", "Expected counterpart.name John");
            client.assert(item.counterpart.role === "SELLER", "Expected counterpart.role SELLER");
        });
    }
%}

