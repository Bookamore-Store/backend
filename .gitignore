# Коментарі — тільки на власному рядку: git не підтримує їх у кінці рядка
# з шаблоном, і тоді весь рядок разом із пробілами й «#» стає шаблоном,
# який ні з чим не збігається. Саме через це файл раніше не ігнорував нічого.

# General files to ignore
HELP.md

# JVM and compiled output
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
# JVM crash dumps
hs_err_pid*.log

# Maven specific
/target/
# Generated by Maven plugins (release plugin and friends)
pom.xml.tag
pom.xml.versionsBackup
pom.xml.next
release.properties
release-pom.xml
.mvn/wrapper/maven-wrapper.jar

# IDE specific files
## IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
.idea_modules/
# IntelliJ compiler output (if not 'target/')
out/

## Eclipse / Spring Tool Suite (STS)
.project
.classpath
.settings/
.apt_generated/
.factorypath
.springBeans

## NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

## VS Code
.vscode/

# Log files
*.log
logs/

# Miscellaneous temporary files
*.bak
*.temp
*.tmp

# ENVIROMENT
/src/main/resources/.env

# UPLOAD DIRECTORY
/src/main/resources/uploads/
